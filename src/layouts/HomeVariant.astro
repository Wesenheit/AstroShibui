---
import BaseLayout from "./BaseLayout.astro";

interface Props {
    title: string;
    date: string;
    avatarUrl: string;
}

const { title, date, avatarUrl } = Astro.props;
const github = "wesenheit";
const tangled = "mrkap.eu";
const email = "mateusz.kapusta@tuebingen.mpg.de";
const topics = ["Generative modeling", "Bayesian inference", "HPC"];
---

<BaseLayout title={title} date={date} showHeader={false}>
    <div class="flex justify-center">
        <div class="max-w-md w-full">
            <!-- Header -->
            <div class="mb-8">
                <h1 class="text-2xl font-bold font-mono">mateusz kapusta</h1>
                <p class="text-sm font-mono">
                    PhD student in CS/ML @ ELLIS/MPI-IS
                </p>
                <hr class="mt-4 border-t-2 border-slate-800" />
            </div>

            <!-- Columns -->
            <div class="flex flex-col md:flex-row gap-8 items-start">
                <!-- Left: Image -->
                <div class="w-full md:flex-[4] min-w-0">
                    <img
                        src={avatarUrl}
                        alt="Profile headshot"
                        class="w-full aspect-square object-cover border border-slate-200"
                    />
                </div>

                <!-- Right: Links -->
                <div class="w-full md:flex-[3] min-w-0 space-y-1 text-sm text-right">
                    <div class="py-1 text-right text-xs"></div>
                    <ul>
                        {topics.map((t) => (
                            <li>{t}</li>
                        ))}
                    </ul>

                    <style>
                        li::marker {
                            content: "> ";
                        }
                    </style>
                    <p class="font-bold">[code]</p>
                    <p>
                        GitHub:{" "}
                        <a
                            href={`https://github.com/${github}`}
                            target="_blank"
                            class="hover:underline"
                        >
                            {github}
                        </a>
                    </p>
                    <p>
                        Tangled:{" "}
                        <a
                            href={`https://tangled.org/${tangled}`}
                            target="_blank"
                            class="hover:underline"
                        >
                            {tangled}
                        </a>
                    </p>
                    <p class="font-bold mt-4">[contact]</p>
                    <p>
                        Email:{" "}
                        <a href={`mailto:${email}`} class="hover:underline">
                            mkapusta
                        </a>
                    </p>
                    <p>
                        LinkedIn:{" "}
                        <a
                            href="https://www.linkedin.com/in/mateusz-kapusta-573489223/"
                            target="_blank"
                            class="hover:underline"
                        >
                            Me
                        </a>
                    </p>
                </div>
            </div>
            <div class="mb-8">
                <hr class="mt-4 border-t-2 border-slate-800" />
                <div class="mt-2" />
                <nav class="space-x-4 text-m font-medium flex justify-center">
                    <a href="/about" class="hover:underline">
                        [about]
                    </a>
                    <a href="/publications" class="hover:underline">
                        [papers]
                    </a>
                    <a href="/cv" class="hover:underline">
                        [cv]
                    </a>
                    <a href="/code" class="hover:underline">
                        [code]
                    </a>
                    <a href="/notes" class="hover:underline">
                        [notes]
                    </a>
                </nav>
            </div>
        </div>
    </div>
</BaseLayout>
